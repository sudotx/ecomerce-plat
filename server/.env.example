# Server configuration — copy to .env and fill in real values.
# Never commit the real .env file.

# Port the API listens on.
# NOTE: avoid 5000 on macOS — AirPlay Receiver (ControlCenter) occupies it.
PORT=5001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_platform

# JWT signing secret (used from phase 3 onwards)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary credentials (used from phase 4 onwards)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=